{
  "name": "@ostro/validation",
  "version": "2.0.0-alpha.1",
  "description": "Validation module for OstroJS",
  "main": "build/validationManager.js",
  "types": "build/validationManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/validationManager.d.ts",
      "default": "./build/validationManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/support": "^2.0.0-alpha.1",
    "@ostro/contracts": "^2.0.0-alpha.1",
    "file-type": "^16.5.1"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "validator",
    "validation"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/validation.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/validation/issues"
  },
  "homepage": "https://github.com/ostrojs/validation#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
